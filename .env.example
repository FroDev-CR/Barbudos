# Supabase project settings. Never expose the service role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private password used by /admin/menu to authorize image uploads.
ADMIN_UPLOAD_KEY=choose-a-long-private-password

# Optional canonical production URL used for social sharing metadata.
NEXT_PUBLIC_SITE_URL=https://barbudos.example.com
